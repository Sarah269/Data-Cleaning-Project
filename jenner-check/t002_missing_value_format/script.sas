/* Mock load of Sarah269/Data-Cleaning-Project's TN_541 dataset.
   In the upstream repo TN_541 is loaded from an Excel workbook via
   libname mylib "/home/u63413844/DataAnalysis"; set mylib.TN_541;
   Here a representative 20-row sample of the same 19 variables is
   loaded inline so the cleaning logic runs self-contained. Rows are
   drawn from the repo's own Housing_1.xlsx and preserve every branch
   the script exercises: all LandUse categories (incl. "VACANT RES LAND"
   which is renamed), SoldAsVacant "N" values, a missing PropertyAddress
   row with a same-ParcelID sibling, and rows with missing OwnerAddress/
   TaxDistrict. */
data tn_wip;
  length UniqueID 8 ParcelID $15 LandUse $25 PropertyAddress $40
         SaleDate 8 SalePrice 8 LegalReference $20 SoldAsVacant $8
         OwnerName $50 OwnerAddress $45 Acreage 8 TaxDistrict $30
         LandValue 8 BuildingValue 8 TotalValue 8 YearBuilt 8
         Bedrooms 8 FullBath 8 HalfBath 8;
  infile datalines dsd dlm='|' truncover;
  input UniqueID ParcelID $ LandUse $ PropertyAddress $ SaleDate :mmddyy10.
        SalePrice LegalReference $ SoldAsVacant $ OwnerName $ OwnerAddress $
        Acreage TaxDistrict $ LandValue BuildingValue TotalValue YearBuilt
        Bedrooms FullBath HalfBath;
  format SaleDate mmddyy10.;
