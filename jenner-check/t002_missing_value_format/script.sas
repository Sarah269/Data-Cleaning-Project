/* ---- From TN_541_DataCleaningII.sas: missing-value profiling with custom formats ---- */
/* (the upstream libname/set of mylib.TN_541 is replaced by the inline load above) */

/* Missing Values  - Character */
  /* format to be used with proc freq for missing values */
  proc format;
  value $missfmt ' '='Missing' other='Not Missing';
  value  missfmt  . ='Missing' other='Not Missing';
  run;

  /* Look at missing for character variables */
  proc freq data=tn_wip;
  format _CHAR_ $missfmt.; /* apply format for the duration of this PROC */
  tables _CHAR_ / missing missprint nocum nopercent;
  *format _NUMERIC_ missfmt.;
  *tables _NUMERIC_ / missing missprint nocum nopercent;
  run;

  /* Which rows have a missing Property Address */
  proc sql;
  select UniqueID, ParcelID, PropertyAddress
  from tn_wip
  where PropertyAddress is missing;
  quit;
